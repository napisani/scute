{
  "name": "@napisani/scute",
  "version": "0.0.19",
  "description": "AI-powered shell assistant",
  "module": "index.ts",
  "type": "module",
  "keywords": [
    "shell",
    "ai",
    "explain",
    "bash",
    "zsh",
    "suggestion",
    "tui"
  ],
  "homepage": "https://github.com/napisani/scute",
  "bugs": {
    "url": "https://github.com/napisani/scute/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/napisani/scute.git"
  },
  "license": "MIT",
  "author": "Nick Pisani",
  "main": "src/index.ts",
  "bin": {
    "scute": "bin/scute"
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:bin",
    "build:bin": "bun scripts/build-bin.ts",
    "clean": "rm -rf dist",
    "lint": "bunx tsc --noEmit",
    "test": "bun test tests/",
    "test:coverage": "bun test tests/ --coverage",
    "test:unit": "bun test tests/",
    "test:evals": "bun test evals --pattern \"\\.eval\\.test\\.ts$\"",
    "test:pty": "python3 scripts/agent/run-all",
    "test:pty:one": "python3 scripts/agent/run-one",
    "prepublishOnly": "bun run lint && bun run test"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "@tanstack/ai": "^0.42.0",
    "@tanstack/ai-anthropic": "^0.16.3",
    "@tanstack/ai-gemini": "^0.20.1",
    "@tanstack/ai-ollama": "^0.8.16",
    "@tanstack/ai-openai": "^0.17.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.2.3",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/shell-quote": "^1.7.5",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ]
}